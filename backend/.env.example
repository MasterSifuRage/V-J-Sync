# Sao chép file này thành `.env` trong cùng thư mục `backend/` và điền giá trị thật.

# PostgreSQL — đổi user, password, host, port, tên DB nếu cần
DATABASE_URL="postgresql://postgres:password@localhost:5432/vjsync?schema=public"

# JWT — dùng chuỗi ngẫu nhiên dài trong môi trường production
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"

# OpenAI — bắt buộc nếu dùng dịch / phân tích / tóm tắt AI
OPENAI_API_KEY="sk-your-openai-api-key"

# Server
PORT=3001
# URL frontend (Vite mặc định) — dùng cho CORS và cookie
CLIENT_URL="http://localhost:5173"
