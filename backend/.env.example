# Sao chép file này thành `.env` trong cùng thư mục `backend/` và điền giá trị thật.

# PostgreSQL — đổi user, password, host, port, tên DB nếu cần
DATABASE_URL="postgresql://postgres:20235846@localhost:5432/vjsync?schema=public"

# JWT — dùng chuỗi ngẫu nhiên dài trong môi trường production
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"

# ── AI (demo khuyên dùng Ollama local) ─────────────────────────────────────
AI_PROVIDER=ollama
SUMMARIZE_PROVIDER=ollama
TRANSLATE_PROVIDER=ollama
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.1:latest"
# Model riêng cho từng tác vụ (tùy chọn):
# OLLAMA_SUMMARIZE_MODEL="llama3.1:latest"
# OLLAMA_TRANSLATE_MODEL="llama3.1:latest"

# Dịch nhanh qua API chuyên dụng (tách khỏi tóm tắt):
# TRANSLATE_PROVIDER=deepl
# DEEPL_API_KEY="your-deepl-auth-key"
# DEEPL_API_URL="https://api-free.deepl.com/v2/translate"
# TRANSLATE_PROVIDER=google
# GOOGLE_TRANSLATE_API_KEY="your-google-cloud-api-key"

# Cloud LLM — dễ bị 429 trên free tier
# SUMMARIZE_PROVIDER=gemini
# GEMINI_API_KEY="your-google-ai-studio-api-key"
# GEMINI_MODEL="gemini-2.0-flash"
# SUMMARIZE_PROVIDER=openai
# OPENAI_API_KEY="sk-your-openai-api-key"

# Server
PORT=3001
# URL frontend — CORS và Socket.IO (nhiều URL cách nhau bằng dấu phẩy)
CLIENT_URL="http://localhost:5173"
# Vercel + dev: http://localhost:5173,https://your-app.vercel.app
