# Sao chép file này thành `.env` trong cùng thư mục `backend/` và điền giá trị thật.

# PostgreSQL — đổi user, password, host, port, tên DB nếu cần
DATABASE_URL="postgresql://postgres:20235846@localhost:5432/vjsync?schema=public"

# JWT — dùng chuỗi ngẫu nhiên dài trong môi trường production
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"

# AI — ưu tiên Gemini nếu có GEMINI_API_KEY (https://aistudio.google.com/apikey )
GEMINI_API_KEY="AIzaSyAwSa4eL8Haq9OqjWBABdLUB5kLl9ZZxTo"
# Có thể dùng thay thế: GOOGLE_API_KEY hoặc GOOGLE_GENERATIVE_AI_API_KEY (cùng định dạng AIza...)
# Chỉ dùng Gemini (bỏ qua OpenAI): gemini | openai | auto (mặc định auto)
# AI_PROVIDER=gemini
# Model tùy chọn (mặc định gemini-2.0-flash). Nếu lỗi 404 thử: gemini-1.5-flash
# GEMINI_MODEL="gemini-2.0-flash"
# Số lần thử lại khi 429/5xx (mặc định 4)
# GEMINI_RETRY_ATTEMPTS=4

# OpenAI — key dạng sk-... (không đặt key Google AIza... vào đây; dùng GEMINI_API_KEY)
OPENAI_API_KEY="sk-your-openai-api-key"
# OPENAI_RETRY_ATTEMPTS=5

# Server
PORT=3001
# URL frontend (Vite mặc định) — dùng cho CORS và cookie
CLIENT_URL="http://localhost:5173"
