# Sao chép: cp .env.production.example .env.production
# Dùng với: docker compose up --build

APP_PORT=3001

POSTGRES_USER=vjsync
POSTGRES_PASSWORD=doi-mat-khau-manh-o-day
POSTGRES_DB=vjsync

# URL người dùng mở trên trình duyệt (CORS + cookie + Socket.IO)
# Docker một cổng: http://localhost:3001
# Domain thật: https://your-domain.com
CLIENT_URL=http://localhost:3001

JWT_SECRET=thay-bang-chuoi-ngau-nhien-dai-32-ky-tu-tro-len
JWT_EXPIRES_IN=7d

# Production: khuyến nghị API cloud (Ollama trong Docker cần cấu hình thêm)
AI_PROVIDER=gemini
SUMMARIZE_PROVIDER=gemini
TRANSLATE_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Hoặc Ollama trên máy host (macOS/Windows Docker Desktop):
# AI_PROVIDER=ollama
# SUMMARIZE_PROVIDER=ollama
# TRANSLATE_PROVIDER=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.1:latest

# Tạo tài khoản demo lần đầu (true/false)
RUN_SEED=true

# Đứng sau Nginx/Caddy HTTPS
# TRUST_PROXY=1
